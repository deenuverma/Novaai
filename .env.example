# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Automatically injected at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where NOVAAI is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL connection parameters (Object Method)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# JWT Secrets for email/password access & refresh tokens
JWT_ACCESS_SECRET="change_this_access_secret_in_production"
JWT_REFRESH_SECRET="change_this_refresh_secret_in_production"

# Optional external storage endpoint (falls back to server storage)
CLOUDINARY_URL=""
